<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script><script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script><script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<script>
// Newsat.space index.html එකේම Firebase project සහ collection schema භාවිතා කරයි.
const firebaseConfig={apiKey:"AIzaSyBMmZuPV3XKlYkGqjQYd7aJpFb8MZc-P9k",authDomain:"newsat-209f8.firebaseapp.com",projectId:"newsat-209f8",appId:"1:529324718671:web:0f45e89bf317cbb0c9083a"};
const ADMIN_EMAIL="kularathnashac@gmail.com";
const CLOUDINARY_CLOUD_NAME="afyjcb5r",CLOUDINARY_UPLOAD_PRESET="newsat_upload",CLOUDINARY_FOLDER="newsat";
let auth,db,currentUser=null,isAdmin=false,usersCache=[],newsCache=[];
const $=id=>document.getElementById(id);
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function toast(s){const el=$('toast');el.textContent=s;el.classList.add('show');clearTimeout(window.__toastTimer);window.__toastTimer=setTimeout(()=>el.classList.remove('show'),3600)}
function dateText(v){if(!v)return '—';let d=v.toDate?v.toDate():v.seconds?new Date(v.seconds*1000):new Date(v);return isNaN(d)?'—':d.toLocaleDateString('si-LK',{year:'numeric',month:'short',day:'numeric'});}
function timeValue(v){if(!v)return 0;if(v.seconds)return v.seconds*1000;let d=new Date(v);return isNaN(d)?0:d.getTime()}
function safeImage(url){try{let u=new URL(url);return ['https:'].includes(u.protocol)?u.href:''}catch{return ''}}
function showLoginError(s){$('loginError').textContent=s||''}
function friendly(e){const c=e?.code||'';if(c==='permission-denied')return 'Firebase Rules අවසර ලබා දුන්නේ නැහැ. Admin Custom Claim සහ Firestore Rules පරීක්ෂා කරන්න.';if(c==='auth/invalid-credential')return 'Email හෝ Password වැරදියි.';if(c==='auth/too-many-requests')return 'Login උත්සාහ වැඩියි. ටික වේලාවකින් නැවත උත්සාහ කරන්න.';return e?.message||'දෝෂයක් සිදුවිය.'}
function requireAdmin(){if(!currentUser||!isAdmin)throw new Error('Admin අවසරය අවශ්‍යයි.');}
async function retry(fn,tries=3){let err;for(let i=0;i<tries;i++){try{if(navigator.onLine)await db.enableNetwork();return await fn()}catch(e){err=e;let retryable=['unavailable','deadline-exceeded','aborted','cancelled'].some(x=>(e.code||'').includes(x));if(!retryable||i===tries-1)throw e;await new Promise(r=>setTimeout(r,450*(i+1)))}}throw err}
function navigate(page){if(!isAdmin)return;document.querySelectorAll('.page').forEach(x=>x.classList.remove('active'));$('page-'+page).classList.add('active');document.querySelectorAll('.nav-btn[data-page]').forEach(x=>x.classList.toggle('active',x.dataset.page===page));const titles={dashboard:['Dashboard','ඔබේ වෙබ් අඩවියේ සම්පූර්ණ තත්ත්වය'],users:['පරිශීලක කළමනාකරණය','ලියාපදිංචි සාමාජිකයින්ගේ Profile'],news:['පුවත් කළමනාකරණය','සියලුම පුවත් පාලනය කරන්න']};$('pageTitle').textContent=titles[page][0];$('pageSubtitle').textContent=titles[page][1];$('sidebar').classList.remove('open');if(page==='users')renderUsers();if(page==='news')renderNews();}
function setLoggedIn(user){$('loginView').classList.add('hidden');$('appView').classList.remove('hidden');$('adminEmailLabel').textContent=user.email;$('topAdminEmail').textContent=user.email;$('adminAvatar').textContent=(user.email||'A').slice(0,1).toUpperCase();}
async function authChanged(user){currentUser=user;isAdmin=false;if(!user){$('appView').classList.add('hidden');$('loginView').classList.remove('hidden');return;}try{const token=await user.getIdTokenResult(true);isAdmin=(user.email||'').toLowerCase()===ADMIN_EMAIL.toLowerCase()&&token.claims.admin===true;if(!isAdmin){await auth.signOut();$('appView').classList.add('hidden');$('loginView').classList.remove('hidden');showLoginError('මෙම ගිණුමට Admin අවසරය නැහැ. නිවැරදි Admin ගිණුම භාවිතා කරන්න.');return;}setLoggedIn(user);await refreshAll();}catch(e){$('appView').classList.add('hidden');$('loginView').classList.remove('hidden');showLoginError(friendly(e));}}
async function refreshAll(){requireAdmin();toast('දත්ත Refresh කරමින්...');try{const [us,ns]=await Promise.all([retry(()=>db.collection('users').get()),retry(()=>db.collection('news').get())]);usersCache=us.docs.map(d=>({id:d.id,...d.data()}));newsCache=ns.docs.map(d=>({id:d.id,...d.data()}));usersCache.sort((a,b)=>timeValue(b.createdAt)-timeValue(a.createdAt));newsCache.sort((a,b)=>timeValue(b.createdAt)-timeValue(a.createdAt));updateDashboard();renderUsers();renderNews();}catch(e){toast(friendly(e));console.error(e)}}
function updateDashboard(){const approved=newsCache.filter(n=>(n.status||'Pending')==='Approved').length,pending=newsCache.filter(n=>(n.status||'Pending')==='Pending').length;$('statUsers').textContent=usersCache.length.toLocaleString();$('statNews').textContent=newsCache.length.toLocaleString();$('statPublished').textContent=approved.toLocaleString();$('statPending').textContent=pending.toLocaleString();$('recentNews').innerHTML=newsCache.slice(0,5).map(newsCard).join('')||'<div class="empty">තවම පුවත් නැත.</div>';$('recentUsers').innerHTML=usersCache.slice(0,5).map(userRowCompact).join('')||'<div class="empty">තවම පරිශීලකයින් නැත.</div>'}
function userRowCompact(u){const name=u.name||u.displayName||'නම සඳහන් නැත',pic=safeImage(u.photoURL);return `<div class="user-cell" style="padding:9px 0"><div class="user-pic">${pic?`<img src="${esc(pic)}" style="width:100%;height:100%;object-fit:cover;border-radius:50%">`:esc(name.slice(0,1).toUpperCase())}</div><div><b>${esc(name)}</b><small>${esc(u.email||'')}</small></div></div>`}
function renderUsers(){if(!$('usersTable'))return;let q=$('userSearch').value.trim().toLowerCase(),role=$('userRoleFilter').value,sort=$('userSort').value;let arr=usersCache.filter(u=>{let s=[u.name,u.email,u.uid,u.phone,u.location].join(' ').toLowerCase();return(!q||s.includes(q))&&(!role||(u.role||'Writer')===role)});if(sort==='old')arr.sort((a,b)=>timeValue(a.createdAt)-timeValue(b.createdAt));if(sort==='name')arr.sort((a,b)=>(a.name||'').localeCompare(b.name||''));$('usersTable').innerHTML=arr.length?arr.map(u=>`<tr><td>${userCell(u)}</td><td>${esc(u.phone||'—')}</td><td>${esc(u.location||'—')}</td><td><span class="pill">${esc(u.role||'Writer')}</span></td><td>${dateText(u.createdAt)}</td><td><div class="row-actions"><button class="mini-btn" onclick="openUser('${esc(u.id)}')">View / Edit</button><button class="mini-btn red" onclick="deleteUserProfile('${esc(u.id)}')">Delete Profile</button></div></td></tr>`).join(''):`<tr><td colspan="6" class="empty">ගැළපෙන පරිශීලකයෙකු හමු නොවීය.</td></tr>`}
function userCell(u){let n=u.name||'නම සඳහන් නැත',p=safeImage(u.photoURL);return `<div class="user-cell"><div class="user-pic">${p?`<img src="${esc(p)}" style="width:100%;height:100%;object-fit:cover;border-radius:50%">`:esc(n.slice(0,1).toUpperCase())}</div><div><b>${esc(n)}</b><small>${esc(u.email||'')}</small></div></div>`}
function openUser(id){requireAdmin();let u=usersCache.find(x=>x.id===id);if(!u)return; $('editUserId').value=id;$('editUserName').value=u.name||'';$('editUserEmail').value=u.email||'';$('editUserPhone').value=u.phone||'';$('editUserLocation').value=u.location||'';$('editUserOccupation').value=u.occupation||'';$('editUserWebsite').value=u.website||'';$('editUserPhoto').value=u.photoURL||'';$('editUserBio').value=u.bio||'';$('userFormError').textContent='';openModal('userModal')}
async function saveUser(e){e.preventDefault();requireAdmin();const id=$('editUserId').value,btn=$('saveUserBtn');btn.disabled=true;$('userFormError').textContent='';try{const data={name:$('editUserName').value.trim(),phone:$('editUserPhone').value.trim(),location:$('editUserLocation').value.trim(),occupation:$('editUserOccupation').value.trim(),website:$('editUserWebsite').value.trim(),photoURL:$('editUserPhoto').value.trim(),bio:$('editUserBio').value.trim(),updatedAt:firebase.firestore.FieldValue.serverTimestamp(),updatedBy:currentUser.uid};await retry(()=>db.collection('users').doc(id).update(data));closeModal('userModal');toast('පරිශීලක Profile එක Update කළා.');await refreshAll();}catch(e){$('userFormError').textContent=friendly(e)}finally{btn.disabled=false}}
async function deleteUserProfile(id){requireAdmin();const u=usersCache.find(x=>x.id===id);if(!u)return;if(id===currentUser.uid){toast('ඔබේම Admin Profile එක මෙතැනින් මකා දැමිය නොහැක.');return;}if(!confirm(`${u.name||u.email||id} ගේ Firestore Profile දත්ත මකා දමන්නද? Firebase Authentication Login ගිණුම මැකෙන්නේ නැත.`))return;try{await retry(()=>db.collection('users').doc(id).delete());toast('Firestore Profile දත්ත මකා දැමුවා.');await refreshAll()}catch(e){toast(friendly(e))}}
function newsCard(n){const img=safeImage(n.image),status=n.status||'Pending';return `<article class="news-item">${img?`<img class="news-thumb" src="${esc(img)}" alt="">`:'<div class="news-thumb" style="display:grid;place-items:center;font-size:25px">📰</div>'}<div style="min-width:0;flex:1"><h4>${esc(n.title||'මාතෘකාවක් නැත')}</h4><p>${esc(n.category||'')} · ${esc(n.author||n.authorEmail||'')}<br>${dateText(n.createdAt)}</p><span class="pill ${esc(status)}">${esc(status)}</span><div class="row-actions"><button class="mini-btn" onclick="openNews('${esc(n.id)}')">Edit</button>${status!=='Approved'?`<button class="mini-btn green" onclick="setNewsStatus('${esc(n.id)}','Approved')">Publish</button>`:''}<button class="mini-btn red" onclick="deleteNews('${esc(n.id)}')">Delete</button></div></div></article>`}
function renderNews(){let q=$('newsSearch').value.trim().toLowerCase(),st=$('newsStatus').value,cat=$('newsCategory').value;let arr=newsCache.filter(n=>(!q||[n.title,n.author,n.authorEmail,n.body].join(' ').toLowerCase().includes(q))&&(!st||(n.status||'Pending')===st)&&(!cat||n.category===cat));$('newsCards').innerHTML=arr.map(newsCard).join('')||'<div class="empty">ගැළපෙන පුවත් හමු නොවීය.</div>'}
function openNews(id){requireAdmin();let n=newsCache.find(x=>x.id===id);if(!n)return;$('editNewsId').value=id;$('editNewsTitle').value=n.title||'';$('editNewsCategory').value=n.category||'දේශීය';$('editNewsStatus').value=n.status||'Pending';$('editNewsBody').value=n.body||'';$('editNewsImage').value=n.image||'';$('editNewsFile').value='';$('newsFormError').textContent='';openModal('newsModal')}
async function uploadCloudinary(file){let fd=new FormData();fd.append('file',file);fd.append('upload_preset',CLOUDINARY_UPLOAD_PRESET);fd.append('folder',CLOUDINARY_FOLDER);let r=await fetch(`https://api.cloudinary.com/v1_1/${CLOUDINARY_CLOUD_NAME}/image/upload`,{method:'POST',body:fd});let j=await r.json();if(!r.ok)throw new Error(j.error?.message||'Cloudinary Upload අසාර්ථකයි.');return j.secure_url}
async function saveNews(e){e.preventDefault();requireAdmin();const btn=$('saveNewsBtn');btn.disabled=true;$('newsFormError').textContent='';try{const id=$('editNewsId').value,title=$('editNewsTitle').value.trim(),body=$('editNewsBody').value.trim();if(!title||!body)throw new Error('මාතෘකාව සහ විස්තරය අවශ්‍යයි.');let image=$('editNewsImage').value.trim(),file=$('editNewsFile').files[0];if(file){if(file.size>5*1024*1024||!['image/jpeg','image/png','image/webp'].includes(file.type))throw new Error('5MB ට අඩු JPG, PNG හෝ WebP ඡායාරූපයක් තෝරන්න.');image=await uploadCloudinary(file)}await retry(()=>db.collection('news').doc(id).update({title,body,category:$('editNewsCategory').value,status:$('editNewsStatus').value,image,updatedAt:firebase.firestore.FieldValue.serverTimestamp(),updatedBy:currentUser.uid}));closeModal('newsModal');toast('පුවත Update කළා.');await refreshAll()}catch(e){$('newsFormError').textContent=friendly(e)}finally{btn.disabled=false}}
async function setNewsStatus(id,status){requireAdmin();try{await retry(()=>db.collection('news').doc(id).update({status,updatedAt:firebase.firestore.FieldValue.serverTimestamp(),updatedBy:currentUser.uid}));toast(status==='Approved'?'පුවත Publish කළා.':'පුවතේ තත්ත්වය වෙනස් කළා.');await refreshAll()}catch(e){toast(friendly(e))}}
async function deleteNews(id){requireAdmin();const n=newsCache.find(x=>x.id===id);if(!n||!confirm(`“${n.title||'මෙම පුවත'}” සදහටම මකා දමන්නද?`))return;try{await retry(()=>db.collection('news').doc(id).delete());toast('පුවත මකා දැමුවා.');await refreshAll()}catch(e){toast(friendly(e))}}
function openModal(id){$(id).classList.add('open')}function closeModal(id){$(id).classList.remove('open')}
function csvDownload(name,rows){const csv='\ufeff'+rows.map(row=>row.map(v=>'"'+String(v??'').replace(/"/g,'""')+'"').join(',')).join('\r\n');const a=document.createElement('a'),url=URL.createObjectURL(new Blob([csv],{type:'text/csv;charset=utf-8'}));a.href=url;a.download=name;a.click();URL.revokeObjectURL(url)}
function exportUsers(){requireAdmin();csvDownload('newsat-users.csv',[['UID','Name','Email','Phone','Location','Occupation','Role','Created'],...usersCache.map(u=>[u.uid||u.id,u.name,u.email,u.phone,u.location,u.occupation,u.role,dateText(u.createdAt)])])}
function exportNews(){requireAdmin();csvDownload('newsat-news.csv',[['ID','Title','Category','Author','Email','Status','Created'],...newsCache.map(n=>[n.id,n.title,n.category,n.author,n.authorEmail,n.status,dateText(n.createdAt)])])}
$('loginForm').addEventListener('submit',async e=>{e.preventDefault();showLoginError('');$('loginBtn').disabled=true;try{await auth.signInWithEmailAndPassword($('loginEmail').value.trim(),$('loginPassword').value)}catch(e){showLoginError(friendly(e))}finally{$('loginBtn').disabled=false}});
$('logoutBtn').addEventListener('click',()=>auth.signOut());$('refreshAll').addEventListener('click',refreshAll);$('menuBtn').addEventListener('click',()=>$('sidebar').classList.toggle('open'));
document.querySelectorAll('.nav-btn[data-page]').forEach(b=>b.addEventListener('click',()=>navigate(b.dataset.page)));document.querySelectorAll('[data-close]').forEach(b=>b.addEventListener('click',()=>closeModal(b.dataset.close)));document.querySelectorAll('.modal').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)m.classList.remove('open')}));
$('userForm').addEventListener('submit',saveUser);$('newsForm').addEventListener('submit',saveNews);['userSearch','userRoleFilter','userSort'].forEach(id=>$(id).addEventListener('input',renderUsers));['newsSearch','newsStatus','newsCategory'].forEach(id=>$(id).addEventListener('input',renderNews));$('exportUsers').addEventListener('click',exportUsers);$('exportNews').addEventListener('click',exportNews);
document.addEventListener('keydown',e=>{if(e.key==='Escape')document.querySelectorAll('.modal.open').forEach(m=>m.classList.remove('open'))});window.addEventListener('online',()=>{if(isAdmin)refreshAll()});
try{firebase.initializeApp(firebaseConfig);auth=firebase.auth();db=firebase.firestore();db.enableNetwork().catch(()=>{});auth.onAuthStateChanged(authChanged)}catch(e){showLoginError('Firebase ආරම්භ කිරීමේ දෝෂය: '+friendly(e))}
</script>
</body></html>
